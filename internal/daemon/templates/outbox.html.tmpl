<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Outbox</title>
<style>
:root{--bg:#fafaf9;--fg:#1c1917;--muted:#57534e;--card:#fff;--line:#e7e5e4;--accent:#15803d;--warn:#b45309;--deny:#b91c1c}
@media (prefers-color-scheme:dark){:root{--bg:#1c1917;--fg:#f5f5f4;--muted:#a8a29e;--card:#292524;--line:#44403c;--accent:#4ade80;--warn:#fbbf24;--deny:#f87171}}
*{box-sizing:border-box}body{font-family:system-ui,sans-serif;background:var(--bg);color:var(--fg);max-width:60rem;margin:2.5rem auto;padding:0 1rem;line-height:1.45}
h1{font-size:1.5rem;margin:0 0 .25rem}h2{font-size:1.1rem;margin:0 0 .75rem}p.lead,.muted,small{color:var(--muted)}
.card{background:var(--card);border:1px solid var(--line);border-radius:.75rem;padding:1.1rem 1.25rem;margin:1rem 0}
.err{border-color:var(--deny);color:var(--deny)}
table{width:100%;border-collapse:collapse}td,th{padding:.5rem .4rem;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}
th{font-size:.8rem;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
.jid{font-family:ui-monospace,monospace;font-size:.8rem;color:var(--muted);word-break:break-all}
.pill{font-size:.75rem;padding:.1rem .5rem;border-radius:999px;border:1px solid var(--line);white-space:nowrap}
.allowed{color:var(--accent);border-color:var(--accent)}.denied{color:var(--deny);border-color:var(--deny)}
form.inline{display:inline}button{font:inherit;font-size:.85rem;padding:.3rem .65rem;border-radius:.45rem;border:1px solid var(--line);background:var(--bg);color:var(--fg);cursor:pointer}
button.go{background:var(--accent);border-color:var(--accent);color:#fff}button.no{color:var(--deny);border-color:var(--deny)}
input[type=search]{font:inherit;padding:.45rem .7rem;border-radius:.45rem;border:1px solid var(--line);background:var(--bg);color:var(--fg);width:100%;max-width:22rem}
.row{display:flex;gap:.75rem;align-items:center;flex-wrap:wrap}
@media (max-width:40rem){.hide-sm{display:none}}
</style>
</head><body>
<h1>Outbox</h1>
<p class="lead">The AI proposed these actions. Nothing is sent until you approve it. Proposals expire after 15 minutes; a proposed scheduled message waits until its send time.</p>
{{if .Error}}<div class="card err"><strong>Error:</strong> {{.Error}}</div>{{end}}
<section class="card">
<h2>Awaiting approval</h2>
{{range .Pending}}
<div class="card">
<pre style="white-space:pre-wrap;margin:0 0 .75rem;font-family:ui-monospace,monospace">{{.Summary}}</pre>
<div class="row">
{{if .SendAt}}<small>#{{.ID}} · by {{or .CreatedBy "unknown"}} · to be sent {{.SendAt.Local.Format "2006-01-02 15:04 MST"}}</small>
<form class="inline" method="post" action="/outbox/{{.ID}}/approve"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button class="go" type="submit">Approve schedule</button></form>
{{else}}<small>#{{.ID}} · by {{or .CreatedBy "unknown"}} · expires {{.ExpiresAt.Local.Format "15:04:05"}}</small>
<form class="inline" method="post" action="/outbox/{{.ID}}/approve"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button class="go" type="submit">Approve and send</button></form>{{end}}
<form class="inline" method="post" action="/outbox/{{.ID}}/reject"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button class="no" type="submit">Reject</button></form>
</div>
</div>
{{else}}<p class="muted">Nothing is waiting.</p>{{end}}
</section>
<section class="card">
<h2>Scheduled</h2>
{{range .Scheduled}}
<div class="card">
<pre style="white-space:pre-wrap;margin:0 0 .75rem;font-family:ui-monospace,monospace">{{.Summary}}</pre>
<div class="row">
<small>#{{.ID}} · by {{or .CreatedBy "unknown"}} · sends {{if .SendAt}}{{.SendAt.Local.Format "2006-01-02 15:04 MST"}}{{end}}</small>
<form class="inline" method="post" action="/outbox/{{.ID}}/cancel"><input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><button class="no" type="submit">Cancel</button></form>
</div>
</div>
{{else}}<p class="muted">No scheduled messages.</p>{{end}}
</section>
<section class="card">
<h2>Recent</h2>
<table><tr><th>#</th><th>Action</th><th class="hide-sm">By</th><th>Status</th></tr>
{{range .Recent}}<tr><td>{{.ID}}</td><td><small style="white-space:pre-wrap">{{.Summary}}</small>{{if .Result}}<br><small class="muted">{{.Result}}</small>{{end}}</td><td class="hide-sm"><small>{{or .CreatedBy "unknown"}}</small></td><td><span class="pill">{{.Status}}</span></td></tr>
{{else}}<tr><td colspan="4" class="muted">No proposals yet.</td></tr>{{end}}
</table>
</section>
<p><small>From a terminal: <code>wpp-mcp outbox</code>, <code>wpp-mcp outbox approve &lt;id&gt;</code>, <code>wpp-mcp outbox cancel &lt;id&gt;</code>, <code>wpp-mcp schedule</code>.</small></p>
</body></html>
