{{define "access_style"}}<style nonce="{{.}}">
:root{--bg:#fafaf9;--fg:#1c1917;--muted:#57534e;--card:#fff;--line:#e7e5e4;--accent:#15803d;--warn:#b45309;--deny:#b91c1c}
@media (prefers-color-scheme:dark){:root{--bg:#1c1917;--fg:#f5f5f4;--muted:#a8a29e;--card:#292524;--line:#44403c;--accent:#4ade80;--warn:#fbbf24;--deny:#f87171}}
*{box-sizing:border-box}body{font-family:system-ui,sans-serif;background:var(--bg);color:var(--fg);max-width:60rem;margin:2.5rem auto;padding:0 1rem;line-height:1.45}
h1{font-size:1.5rem;margin:0 0 .25rem}h2{font-size:1.1rem;margin:0 0 .75rem}p.lead,.muted,small{color:var(--muted)}
.card{background:var(--card);border:1px solid var(--line);border-radius:.75rem;padding:1.1rem 1.25rem;margin:1rem 0}
.err{border-color:var(--deny);color:var(--deny)}.ok{border-color:var(--accent)}
.mode-all{border-color:var(--warn);border-width:2px}.mode-all strong.mode{color:var(--warn)}
.pending{border-color:var(--accent);border-width:2px}
table{width:100%;border-collapse:collapse}td,th{padding:.5rem .4rem;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}
th{font-size:.8rem;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
td.sel,th.sel{width:1.5rem}
.jid{font-family:ui-monospace,monospace;font-size:.8rem;color:var(--muted);word-break:break-all}
.pill{font-size:.75rem;padding:.1rem .5rem;border-radius:999px;border:1px solid var(--line);white-space:nowrap}
.allowed{color:var(--accent);border-color:var(--accent)}.denied{color:var(--deny);border-color:var(--deny)}
form.inline{display:inline}button,a.button{font:inherit;font-size:.85rem;padding:.3rem .65rem;border-radius:.45rem;border:1px solid var(--line);background:var(--bg);color:var(--fg);cursor:pointer;text-decoration:none;display:inline-block}
button.go,a.button.go{background:var(--accent);border-color:var(--accent);color:#fff}button.no,a.button.no{color:var(--deny);border-color:var(--deny)}
button:disabled{opacity:.5;cursor:default}
select{font:inherit;font-size:.85rem;padding:.25rem .4rem;border-radius:.45rem;border:1px solid var(--line);background:var(--bg);color:var(--fg)}
input[type=search]{font:inherit;padding:.45rem .7rem;border-radius:.45rem;border:1px solid var(--line);background:var(--bg);color:var(--fg);width:100%;max-width:22rem}
.row{display:flex;gap:.75rem;align-items:center;flex-wrap:wrap}.between{justify-content:space-between}
nav.filters{margin:.25rem 0 .75rem}nav.filters a{font-size:.85rem;color:var(--fg);text-decoration:none;padding:.2rem .6rem;border-radius:999px;border:1px solid var(--line)}
nav.filters a.active{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.pager{margin-top:.75rem}.pager a{color:var(--fg)}
ul.chats{max-height:20rem;overflow:auto;padding-left:1.25rem}
@media (max-width:40rem){.hide-sm{display:none}}
pre.notes{white-space:pre-wrap;word-break:break-word;background:var(--bg2,#f6f6f6);padding:.75rem;border-radius:.4rem}
</style>{{end}}
