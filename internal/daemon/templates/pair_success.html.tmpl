<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Paired</title>
<style>
:root{--bg:#fafaf9;--fg:#1c1917;--muted:#57534e;--card:#fff;--line:#e7e5e4;--accent:#15803d}
@media (prefers-color-scheme:dark){:root{--bg:#1c1917;--fg:#f5f5f4;--muted:#a8a29e;--card:#292524;--line:#44403c;--accent:#4ade80}}
*{box-sizing:border-box}body{font-family:system-ui,sans-serif;background:var(--bg);color:var(--fg);max-width:56rem;margin:3rem auto;padding:0 1rem;line-height:1.5}
h1{font-size:1.5rem;margin:0 0 .25rem}p.lead{color:var(--muted);margin:0 0 1.5rem}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(16rem,1fr));gap:1rem}
.card{background:var(--card);border:1px solid var(--line);border-radius:.75rem;padding:1.25rem}
.card h2{font-size:1.05rem;margin:0 0 .5rem}.card ol{padding-left:1.2rem;margin:.5rem 0;color:var(--muted)}
img.qr{width:100%;max-width:16rem;background:#fff;padding:.5rem;border-radius:.5rem}
input,button{font:inherit;padding:.55rem .75rem;border-radius:.5rem;border:1px solid var(--line);background:var(--bg);color:var(--fg);width:100%}
button{background:var(--accent);color:#fff;border:0;margin-top:.5rem;cursor:pointer;font-weight:600}
code.big{font-size:2.2rem;letter-spacing:.25rem;font-weight:700;display:inline-block;padding:.5rem 1rem;border:2px dashed var(--accent);border-radius:.5rem}
small,.muted{color:var(--muted)}a{color:var(--accent)}
</style>
</head><body>
<h1>Already paired</h1>
<p class="lead">This daemon is connected to WhatsApp. You can close this tab.</p>
<section class="card">
<form method="post" action="/pair/reset">
  <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
  <button type="submit">Force re-pair</button>
</form>
<p><small>&ldquo;Force re-pair&rdquo; unlinks this device from WhatsApp and starts a fresh pairing flow. Use it to switch accounts. The local message cache is kept.</small></p>
</section>
</body></html>
