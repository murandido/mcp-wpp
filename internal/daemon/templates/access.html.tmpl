<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Chat access</title>
{{template "access_style" .Nonce}}
</head><body>
<h1>Chat access</h1>
<p class="lead">wpp-mcp caches every chat, but the AI only sees the chats allowed here. Changes apply immediately.</p>

{{if .Error}}<div class="card err"><strong>Error:</strong> {{.Error}}</div>{{end}}
{{if .Notice}}<div class="card ok">{{.Notice}}</div>{{end}}

{{if .Requests}}
<section class="card pending">
<div class="row between">
<h2>Pending requests from the AI ({{len .Requests}})</h2>
<a href="/access?filter=pending">Show matched chats in the list</a>
</div>
<table>
<tr><th>Asked for</th><th>Reason</th><th>Matches</th><th></th></tr>
{{range .Requests}}
<tr>
<td>&ldquo;{{.Query}}&rdquo;<br><small>#{{.ID}} · {{.CreatedAt.Format "2006-01-02 15:04"}}</small></td>
<td>{{.Reason}}</td>
<td><form id="req{{.ID}}" method="post" action="/access/requests/{{.ID}}">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
<input type="hidden" name="q" value="{{$.List.Query}}"><input type="hidden" name="filter" value="{{$.List.Filter}}"><input type="hidden" name="page" value="{{$.List.Page}}">
{{range .Matches}}<label class="row"><input type="checkbox" name="jid" value="{{.JID}}" checked> {{if .Name}}{{.Name}}{{else}}<span class="jid">{{.JID}}</span>{{end}}{{if .IsGroup}} <small>(group)</small>{{end}}</label>{{else}}<span class="muted">no chat matched</span>{{end}}
</form></td>
<td class="row">
<button form="req{{.ID}}" class="go" name="decision" value="approve" type="submit"{{if not .Matches}} disabled{{end}}>Allow selected</button>
<button form="req{{.ID}}" class="no" name="decision" value="reject" type="submit">Dismiss</button>
</td>
</tr>
{{end}}
</table>
</section>
{{end}}

<section class="card{{if eq .Mode "all"}} mode-all{{end}}">
<h2>Mode</h2>
<div class="row between">
<span>Current: <strong class="mode">{{if eq .Mode "all"}}ALL chats are visible, except denied ones{{else}}allowlist: only allowed chats are visible{{end}}</strong></span>
{{if eq .Mode "all"}}<a class="button go" href="/access/mode?mode=allowlist">Switch to allowlist&hellip;</a>
{{else}}<a class="button no" href="/access/mode?mode=all">Expose all chats&hellip;</a>{{end}}
</div>
<p class="muted"><small>Sending (with <code>serve -write</code>) is set per chat: <strong>none</strong> refuses writes, <strong>confirm</strong> waits for your approval in the outbox, <strong>direct</strong> acts at once. A chat must also be visible. Chats on <em>default</em> use {{if .DefaultSend}}<strong>{{.DefaultSend}}</strong>{{else}}the daemon's default (confirm unless <code>-confirm-sends=false</code>){{end}}.</small></p>
</section>

<section class="card">
<div class="row between">
<h2>Chats</h2>
<form method="get" action="/access" class="row" role="search">
<input type="hidden" name="filter" value="{{.List.Filter}}">
<input type="search" name="q" value="{{.List.Query}}" maxlength="100" placeholder="Search by name or number" aria-label="Search by name or number">
<button type="submit">Search</button>
{{if .List.Query}}<a href="{{.ClearURL}}">Clear</a>{{end}}
</form>
</div>
<nav class="filters row" aria-label="Filter">
{{range .Filters}}<a href="{{.URL}}"{{if .Active}} class="active" aria-current="page"{{end}}>{{.Label}}</a>{{end}}
</nav>

<form id="bulk" method="post" action="/access/bulk/review" class="row">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
<input type="hidden" name="q" value="{{.List.Query}}"><input type="hidden" name="filter" value="{{.List.Filter}}"><input type="hidden" name="page" value="{{.List.Page}}">
<span>Selected chats:</span>
<select name="state" aria-label="Bulk action"><option value="allowed">Allow</option><option value="reset">Reset to default</option></select>
<button type="submit"{{if not .Chats}} disabled{{end}}>Review&hellip;</button>
<small>up to {{.MaxBulk}} at a time; you confirm on the next page</small>
</form>

<table>
<tr><th class="sel"><input type="checkbox" id="selall" aria-label="Select all on this page" hidden></th><th>Chat</th><th>Status</th><th>Sending</th><th class="hide-sm">Last message</th><th></th></tr>
{{range .Chats}}
<tr>
<td class="sel"><input type="checkbox" name="chat" value="{{.JID}}" form="bulk" aria-label="Select {{if .Name}}{{.Name}}{{else}}{{.JID}}{{end}}"></td>
<td>{{if .Name}}{{.Name}}{{else}}<em class="muted">unnamed</em>{{end}}{{if .IsGroup}} <small>(group)</small>{{end}}<br><span class="jid">{{.JID}}</span></td>
<td><span class="pill {{.State}}">{{stateLabel .}}</span></td>
<td><form class="inline" method="post" action="/access/send">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="jid" value="{{.JID}}">
<input type="hidden" name="q" value="{{$.List.Query}}"><input type="hidden" name="filter" value="{{$.List.Filter}}"><input type="hidden" name="page" value="{{$.List.Page}}">
<select name="send" aria-label="Send policy">
<option value="reset"{{if not .Send}} selected{{end}}>default{{if $.DefaultSend}} ({{$.DefaultSend}}){{end}}</option>
<option value="none"{{if eq .Send "none"}} selected{{end}}>none</option>
<option value="confirm"{{if eq .Send "confirm"}} selected{{end}}>confirm</option>
<option value="direct"{{if eq .Send "direct"}} selected{{end}}>direct</option>
</select> <button type="submit">Set</button>
</form></td>
<td class="hide-sm"><small>{{if not .LastMessageTime.IsZero}}{{.LastMessageTime.Format "2006-01-02 15:04"}}{{end}}</small></td>
<td>
<form class="inline" method="post" action="/access/chat">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="jid" value="{{.JID}}">
<input type="hidden" name="q" value="{{$.List.Query}}"><input type="hidden" name="filter" value="{{$.List.Filter}}"><input type="hidden" name="page" value="{{$.List.Page}}">
{{if ne .State "allowed"}}<button class="go" name="state" value="allowed" type="submit">Allow</button>{{end}}
{{if ne .State "denied"}}<button class="no" name="state" value="denied" type="submit">Deny</button>{{end}}
{{if .State}}<button name="state" value="reset" type="submit">Reset</button>{{end}}
</form>
</td>
</tr>
{{else}}
<tr><td colspan="6" class="muted">No chats{{if .List.Query}} match &ldquo;{{.List.Query}}&rdquo;{{else if ne .List.Filter "all"}} in this filter{{else}} cached yet; pair first and wait for the initial sync{{end}}.</td></tr>
{{end}}
</table>
<div class="row between pager">
<small>{{if .Total}}Showing {{.From}}&ndash;{{.To}} of {{.Total}}{{end}}</small>
<span class="row">{{if .PrevURL}}<a href="{{.PrevURL}}">&larr; Previous</a>{{end}}{{if .NextURL}}<a href="{{.NextURL}}">Show more &rarr;</a>{{end}}</span>
</div>
</section>
<p><small>The same actions are available from a terminal: <code>wpp-mcp access requests</code>, <code>wpp-mcp access allow</code>, <code>wpp-mcp access send</code>.</small></p>
<script nonce="{{.Nonce}}">
(function () {
  var all = document.getElementById("selall");
  if (!all) { return; }
  all.hidden = false;
  all.addEventListener("change", function () {
    document.querySelectorAll('input[name="chat"][form="bulk"]').forEach(function (c) { c.checked = all.checked; });
  });
})();
</script>
</body></html>
