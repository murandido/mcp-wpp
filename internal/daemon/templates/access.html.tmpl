<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Chat access</title>
<style>
:root{--bg:#fafaf9;--fg:#1c1917;--muted:#57534e;--card:#fff;--line:#e7e5e4;--accent:#15803d;--warn:#b45309;--deny:#b91c1c}
@media (prefers-color-scheme:dark){:root{--bg:#1c1917;--fg:#f5f5f4;--muted:#a8a29e;--card:#292524;--line:#44403c;--accent:#4ade80;--warn:#fbbf24;--deny:#f87171}}
*{box-sizing:border-box}body{font-family:system-ui,sans-serif;background:var(--bg);color:var(--fg);max-width:60rem;margin:2.5rem auto;padding:0 1rem;line-height:1.45}
h1{font-size:1.5rem;margin:0 0 .25rem}h2{font-size:1.1rem;margin:0 0 .75rem}p.lead,.muted,small{color:var(--muted)}
.card{background:var(--card);border:1px solid var(--line);border-radius:.75rem;padding:1.1rem 1.25rem;margin:1rem 0}
.err{border-color:var(--deny);color:var(--deny)}
table{width:100%;border-collapse:collapse}td,th{padding:.5rem .4rem;border-bottom:1px solid var(--line);text-align:left;vertical-align:middle}
th{font-size:.8rem;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
.jid{font-family:ui-monospace,monospace;font-size:.8rem;color:var(--muted);word-break:break-all}
.pill{font-size:.75rem;padding:.1rem .5rem;border-radius:999px;border:1px solid var(--line);white-space:nowrap}
.allowed{color:var(--accent);border-color:var(--accent)}.denied{color:var(--deny);border-color:var(--deny)}
form.inline{display:inline}button{font:inherit;font-size:.85rem;padding:.3rem .65rem;border-radius:.45rem;border:1px solid var(--line);background:var(--bg);color:var(--fg);cursor:pointer}
button.go{background:var(--accent);border-color:var(--accent);color:#fff}button.no{color:var(--deny);border-color:var(--deny)}
input[type=search]{font:inherit;padding:.45rem .7rem;border-radius:.45rem;border:1px solid var(--line);background:var(--bg);color:var(--fg);width:100%;max-width:22rem}
.row{display:flex;gap:.75rem;align-items:center;flex-wrap:wrap}
@media (max-width:40rem){.hide-sm{display:none}}
</style>
</head><body>
<h1>Chat access</h1>
<p class="lead">wpp-mcp caches every chat, but the AI only sees the chats allowed here. Changes apply immediately.</p>

{{if .Error}}<div class="card err"><strong>Error:</strong> {{.Error}}</div>{{end}}

<section class="card">
<h2>Mode</h2>
<div class="row">
<span>Current: <strong>{{if eq .Mode "all"}}all chats, except denied{{else}}only allowed chats{{end}}</strong></span>
<form class="inline" method="post" action="/access/mode">
<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
{{if eq .Mode "all"}}<input type="hidden" name="mode" value="allowlist"><button type="submit">Switch to allowlist</button>
{{else}}<input type="hidden" name="mode" value="all"><button type="submit" class="no">Expose all chats</button>{{end}}
</form>
</div>
</section>

{{if .Requests}}
<section class="card">
<h2>Pending requests from the AI</h2>
<table>
<tr><th>Asked for</th><th>Reason</th><th>Matches</th><th></th></tr>
{{range .Requests}}
<tr>
<td>&ldquo;{{.Query}}&rdquo;<br><small>#{{.ID}} · {{.CreatedAt.Format "2006-01-02 15:04"}}</small></td>
<td>{{.Reason}}</td>
<td><form id="req{{.ID}}" method="post" action="/access/requests/{{.ID}}">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
{{range .Matches}}<label class="row"><input type="checkbox" name="jid" value="{{.JID}}" checked> {{if .Name}}{{.Name}}{{else}}<span class="jid">{{.JID}}</span>{{end}}</label>{{else}}<span class="muted">no chat matched</span>{{end}}
</form></td>
<td class="row">
<button form="req{{.ID}}" class="go" name="decision" value="approve" type="submit"{{if not .Matches}} disabled{{end}}>Allow selected</button>
<button form="req{{.ID}}" class="no" name="decision" value="reject" type="submit">Reject</button>
</td>
</tr>
{{end}}
</table>
</section>
{{end}}

<section class="card">
<div class="row" style="justify-content:space-between">
<h2>Chats</h2>
<form method="get" action="/access"><input type="search" name="q" value="{{.Query}}" placeholder="Search by name or number"></form>
</div>
<table>
<tr><th>Chat</th><th>Status</th><th class="hide-sm">Last message</th><th></th></tr>
{{range .Chats}}
<tr>
<td>{{if .Name}}{{.Name}}{{else}}<em class="muted">unnamed</em>{{end}}{{if .IsGroup}} <small>(group)</small>{{end}}<br><span class="jid">{{.JID}}</span></td>
<td><span class="pill {{.State}}">{{stateLabel .}}</span></td>
<td class="hide-sm"><small>{{if not .LastMessageTime.IsZero}}{{.LastMessageTime.Format "2006-01-02 15:04"}}{{end}}</small></td>
<td>
<form class="inline" method="post" action="/access/chat">
<input type="hidden" name="csrf_token" value="{{$.CSRFToken}}"><input type="hidden" name="jid" value="{{.JID}}"><input type="hidden" name="q" value="{{$.Query}}">
{{if ne .State "allowed"}}<button class="go" name="state" value="allowed" type="submit">Allow</button>{{end}}
{{if ne .State "denied"}}<button class="no" name="state" value="denied" type="submit">Deny</button>{{end}}
{{if .State}}<button name="state" value="reset" type="submit">Reset</button>{{end}}
</form>
</td>
</tr>
{{else}}
<tr><td colspan="4" class="muted">No chats{{if .Query}} match &ldquo;{{.Query}}&rdquo;{{else}} cached yet; pair first and wait for the initial sync{{end}}.</td></tr>
{{end}}
</table>
</section>
<p><small>Approve requests from a terminal with <code>wpp-mcp access requests</code>.</small></p>
</body></html>
