<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex">
<title>Authorization error</title>
<style>
:root{--bg:#fafaf9;--fg:#1c1917;--muted:#57534e;--card:#fff;--line:#e7e5e4;--deny:#b91c1c}
@media (prefers-color-scheme:dark){:root{--bg:#1c1917;--fg:#f5f5f4;--muted:#a8a29e;--card:#292524;--line:#44403c;--deny:#f87171}}
*{box-sizing:border-box}body{font-family:system-ui,sans-serif;background:var(--bg);color:var(--fg);max-width:40rem;margin:3rem auto;padding:0 1rem;line-height:1.5}
h1{font-size:1.5rem;margin:0 0 .25rem}.muted{color:var(--muted)}
.card{background:var(--card);border:1px solid var(--deny);border-radius:.75rem;padding:1.1rem 1.25rem;margin:1rem 0}
</style>
</head><body>
<h1>This connection cannot be authorized</h1>
<section class="card"><p>{{.Message}}</p></section>
<p class="muted">You were not redirected anywhere. Close this page and check the connector's settings.</p>
</body></html>
